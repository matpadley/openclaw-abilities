# ── Signal CLI configuration ──────────────────────────────────────────────────

# Phone number registered with Signal CLI (E.164 format, e.g. +441234567890)
SIGNAL_SENDER_NUMBER=+441234567890

# Recipient phone number that will receive the tournament reminders
SIGNAL_RECIPIENT_NUMBER=+449876543210

# Delivery mode: "rest" (signal-cli REST API) or "cli" (local binary)
SIGNAL_MODE=rest

# Base URL of the signal-cli REST API (only used when SIGNAL_MODE=rest)
SIGNAL_REST_URL=http://localhost:8080

# Path to the signal-cli binary (only used when SIGNAL_MODE=cli)
SIGNAL_CLI_PATH=signal-cli

# ── Scheduler ─────────────────────────────────────────────────────────────────

# How often (in hours) to check for upcoming tournaments (default: 24)
CHECK_INTERVAL_HOURS=24

# ── Logging ───────────────────────────────────────────────────────────────────

# Python logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
